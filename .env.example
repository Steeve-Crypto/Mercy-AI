MERCY_ENV=local
MERCY_RETENTION_MODE=zero_retention
MERCY_DEFAULT_TIER=free

# LLM provider keys. Set one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LangSmith tracing. Set LANGSMITH_API_KEY locally to send traces to the UI.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mercy-legal-core-dev
LANGSMITH_API_KEY=
