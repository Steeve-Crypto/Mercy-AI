# Mercy Legal AI environment
# Copy to .env or run: py scripts/setup_mercy.py
# Keep secrets out of git.

# Business / Firm
MERCY_BUSINESS_NAME=Mercy AI
MERCY_BUSINESS_EMAIL=support@example.com
MERCY_BUSINESS_PHONE=+1-202-555-0100
MERCY_DC_BAR_NUMBER=123456
MERCY_SUPPORT_EMAIL=support@example.com
MERCY_SUPPORT_URL=https://example.com/support

# Environment / Auth
# Local dev may use MERCY_ENV=local and MERCY_AUTH_MODE=dev.
# CI/CD may use MERCY_ENV=test and MERCY_AUTH_MODE=test with a throwaway token.
# Production must use MERCY_ENV=production, MERCY_AUTH_MODE=supabase, Supabase JWTs, PostgreSQL, and HTTPS.
MERCY_ENV=local
MERCY_AUTH_MODE=dev
MERCY_REQUIRE_HTTPS=false
MERCY_API_TOKEN=replace-with-local-or-ci-token
MERCY_CORE_API_TOKEN=
MERCY_TENANT_ID=local-dev-tenant
MERCY_USER_ID=local-web-server
MERCY_ROLES=attorney
MERCY_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
MERCY_RETENTION_MODE=zero_retention
MERCY_DEFAULT_TIER=free
MERCY_UPLOAD_DIR=

# LLM Providers / Model Routing
# Set at least one provider key. OpenRouter is recommended when using Hermes OpenRouter models.
MERCY_LLM_PROVIDER=openrouter
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MERCY_LLM_FAST_MODEL=
MERCY_LLM_REASONING_MODEL=
MERCY_LLM_OPENAI_FAST_MODEL=openai/gpt-4o-mini
MERCY_LLM_OPENAI_REASONING_MODEL=openai/gpt-4o
MERCY_LLM_ANTHROPIC_FAST_MODEL=anthropic/claude-3-5-haiku-20241022
MERCY_LLM_ANTHROPIC_REASONING_MODEL=anthropic/claude-3-5-sonnet-20241022
MERCY_LLM_GROQ_FAST_MODEL=groq/llama-3.1-8b-instant
MERCY_LLM_GROQ_REASONING_MODEL=groq/llama-3.3-70b-versatile

# Hermes Reasoning Layer
MERCY_ENABLE_HERMES=true
MERCY_HERMES_MODEL=openrouter/nousresearch/hermes-3-llama-3.1-405b
MERCY_HERMES_FALLBACK_MODEL=openrouter/nousresearch/hermes-3-mixtral-8x7b

# PostgreSQL + pgvector
# Primary production database. Supabase may provide this via SUPABASE_DB_URL pooler.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
MERCY_DATABASE_URL=
MERCY_PGVECTOR_DSN=
MERCY_PGVECTOR_TABLE=mercy_dc_chunks
MERCY_RAG_VECTOR_BACKEND=auto
MERCY_RAG_GRAPH_BACKEND=auto

# Optional Qdrant vector backend
MERCY_QDRANT_URL=
MERCY_QDRANT_API_KEY=
MERCY_QDRANT_COLLECTION=dc_legal_knowledge

# Optional Neo4j graph backend
MERCY_NEO4J_URI=
MERCY_NEO4J_USER=
MERCY_NEO4J_PASSWORD=
MERCY_NEO4J_DATABASE=

# Supabase Auth / Hosted Postgres
# SUPABASE_URL is the project API URL. SUPABASE_DB_URL is the Postgres pooler URL.
# Supabase Auth JWTs must include app_metadata.firm_id for firm accounts, or tenant_id for solo accounts.
# MERCY_OFFICE_PKCE_PROVIDER names the Supabase OAuth provider used by Office popup fallback.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
MERCY_OFFICE_NAA_ENABLED=false
MERCY_OFFICE_PKCE_FALLBACK_ENABLED=true
MICROSOFT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_ENTRA_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
MICROSOFT_ENTRA_JWKS_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/discovery/v2.0/keys
MERCY_MICROSOFT_IDENTITY_MAP_JSON={"users":[],"domains":[]}
MERCY_OFFICE_PKCE_PROVIDER=azure
NEXT_PUBLIC_MERCY_OFFICE_PKCE_PROVIDER=azure

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_ID=
STRIPE_PRICE_SOLO=price_solo_example
STRIPE_PRICE_SMALL_FIRM=price_small_firm_example
STRIPE_PRICE_PRACTICE=price_practice_example

# LangSmith Observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mercy-legal-core-prod
LANGSMITH_API_KEY=

# Email / Alerts
RESEND_API_KEY=
MERCY_EMAIL_FROM=Mercy Legal AI <support@example.com>
MERCY_ALERT_EMAIL_TO=alerts@example.com
MERCY_ALERT_SLACK_WEBHOOK=
MERCY_SMTP_HOST=
MERCY_SMTP_PORT=587
MERCY_SMTP_USER=
MERCY_SMTP_PASSWORD=
MERCY_SMTP_USE_TLS=true

# Limits / Operations
MERCY_DAILY_TENANT_COST_CAP_USD=5
MERCY_MONTHLY_TENANT_COST_CAP_USD=100
MERCY_BETA_STRONG_MONTHLY_QUOTA=50
MERCY_RATE_LIMIT_PER_MINUTE=120
MERCY_MAX_UPLOAD_MB=25
MERCY_MAX_CONTEXT_CHARS=120000
MERCY_ALERT_COST_SPIKE_USD=25
MERCY_ALERT_GUARDRAIL_FAILURES=10
MERCY_ALERT_ERROR_RATE=0.10

# D.C. knowledge seeding / evaluation
MERCY_SEED_TENANT_ID=public
MERCY_SEED_USER_ID=dc-knowledge-seeder
MERCY_SEED_MIN_CHUNKS=500
MERCY_SEED_LLM_LIMIT=20
MERCY_SEED_REPORT_PATH=reports/dc_knowledge_seed_latest.json
MERCY_RAGAS_REGRESSION_REPORT=
MERCY_ENABLE_REAL_LORA_TRAINING=false

# Web App
MERCY_CORE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MERCY_CORE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MERCY_TENANT_ID=local-dev-tenant
NEXT_PUBLIC_MERCY_USER_ID=local-web-user
NEXT_PUBLIC_MERCY_API_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Office Add-in
VITE_MERCY_CORE_API_URL=http://127.0.0.1:8000
VITE_MERCY_WEB_AUTH_URL=https://127.0.0.1:3000
VITE_MERCY_OFFICE_PKCE_FALLBACK_ENABLED=true
VITE_MERCY_API_TOKEN=
VITE_MERCY_ENV=local
VITE_MERCY_AUTH_MODE=dev
VITE_MERCY_TENANT_ID=local-dev-tenant
VITE_MERCY_USER_ID=office-addin-user
