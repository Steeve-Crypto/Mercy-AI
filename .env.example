MERCY_ENV=local
MERCY_AUTH_MODE=dev
MERCY_API_TOKEN=
MERCY_CORE_API_TOKEN=
MERCY_RETENTION_MODE=zero_retention
MERCY_DEFAULT_TIER=free
MERCY_TENANT_ID=local-dev-tenant
MERCY_USER_ID=local-web-server
MERCY_ROLES=attorney
MERCY_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
MERCY_UPLOAD_DIR=

# PostgreSQL + pgvector is the primary production database.
# Supabase is supported as a hosted Postgres/Auth provider; use its pooler URL here.
POSTGRES_URL=
MERCY_DATABASE_URL=
SUPABASE_DB_URL=

# Supabase Auth/project API settings. SUPABASE_URL is the project URL, not the Postgres DSN.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Next.js web app. NEXT_PUBLIC_SUPABASE_* enables real Supabase Auth middleware.
NEXT_PUBLIC_MERCY_CORE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MERCY_TENANT_ID=local-dev-tenant
NEXT_PUBLIC_MERCY_USER_ID=local-web-user
NEXT_PUBLIC_MERCY_API_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

MERCY_RAG_VECTOR_BACKEND=local
MERCY_RAG_GRAPH_BACKEND=local
MERCY_QDRANT_URL=
MERCY_QDRANT_API_KEY=
MERCY_QDRANT_COLLECTION=dc_legal_knowledge
MERCY_PGVECTOR_DSN=
MERCY_PGVECTOR_TABLE=mercy_dc_chunks
MERCY_NEO4J_URI=
MERCY_NEO4J_USER=
MERCY_NEO4J_PASSWORD=
MERCY_NEO4J_DATABASE=
MERCY_SEED_TENANT_ID=public
MERCY_SEED_USER_ID=dc-knowledge-seeder
MERCY_SEED_MIN_CHUNKS=500
MERCY_SEED_LLM_LIMIT=20
MERCY_SEED_REPORT_PATH=reports/dc_knowledge_seed_latest.json

# LLM provider keys. Set one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MERCY_LLM_PROVIDER=
MERCY_LLM_FAST_MODEL=
MERCY_LLM_REASONING_MODEL=
MERCY_LLM_OPENAI_FAST_MODEL=openai/gpt-4o-mini
MERCY_LLM_OPENAI_REASONING_MODEL=openai/gpt-4o
MERCY_LLM_ANTHROPIC_FAST_MODEL=anthropic/claude-3-5-haiku-20241022
MERCY_LLM_ANTHROPIC_REASONING_MODEL=anthropic/claude-3-5-sonnet-20241022
MERCY_LLM_GROQ_FAST_MODEL=groq/llama-3.1-8b-instant
MERCY_LLM_GROQ_REASONING_MODEL=groq/llama-3.3-70b-versatile

# LangSmith tracing. Set LANGSMITH_API_KEY locally to send traces to the UI.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mercy-legal-core-dev
LANGSMITH_API_KEY=

# Production monitoring, alerting, and cost controls.
MERCY_DAILY_TENANT_COST_CAP_USD=0
MERCY_ALERT_COST_SPIKE_USD=25
MERCY_ALERT_GUARDRAIL_FAILURES=10
MERCY_ALERT_ERROR_RATE=0.10
MERCY_ALERT_SLACK_WEBHOOK=
MERCY_ALERT_EMAIL_TO=
