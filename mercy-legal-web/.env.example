NEXT_PUBLIC_MERCY_CORE_API_URL=http://127.0.0.1:8000
MERCY_CORE_API_URL=http://127.0.0.1:8000
MERCY_ENV=local
MERCY_AUTH_MODE=dev
NEXT_PUBLIC_MERCY_ENV=local
NEXT_PUBLIC_MERCY_AUTH_MODE=dev
NEXT_PUBLIC_MERCY_TENANT_ID=local-dev-tenant
NEXT_PUBLIC_MERCY_USER_ID=local-web-user
NEXT_PUBLIC_MERCY_API_TOKEN=

# Enable real Supabase Auth when present. Leave blank only for the explicit local/dev bypass above.
# Production must set MERCY_ENV=production and MERCY_AUTH_MODE=supabase in both web and Core.
# Paid signup/admin provisioning writes authorization to server-owned app_metadata. user_metadata
# may contain full_name, firm_name, D.C. Bar number, and pending onboarding display fields only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe beta signup. Use a single recurring $98/month seat price; firm quantity controls seats.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BETA_SEAT=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MERCY_APP_URL=http://127.0.0.1:3000

# Server-side backend call context for App Router Server Components.
MERCY_CORE_API_TOKEN=
MERCY_API_TOKEN=
MERCY_TENANT_ID=local-dev-tenant
MERCY_USER_ID=local-web-server
MERCY_ROLES=attorney
